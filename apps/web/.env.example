# Copy to apps/web/.env.local and fill in. .env.local is git-ignored.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# --- App -------------------------------------------------------------------
# Public origin used in auth email and OAuth redirect links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe for the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Not used by Week 1 code; reserved for background jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in -------------------------------------------------------
# Shows "Continue with Google" on login/signup. Set to true only after the
# Google provider is switched on in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false
# Set these in the Supabase dashboard (Authentication → Providers → Google).
# Only needed here when running Supabase locally with `supabase start`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Later tickets (photo storage, jobs, email, monitoring) ----------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
TRIGGER_SECRET_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
